[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[user]
	name = Brandon M. Keltz
	email = keltzbm@icloud.com
[core]
	excludesfile = ~/.gitignore_global
	# delta shows diffs with syntax colors; plain less where it isn't installed
	pager = "if command -v delta >/dev/null 2>&1; then exec delta; else exec less; fi"
[interactive]
	diffFilter = "if command -v delta >/dev/null 2>&1; then exec delta --color-only; else exec cat; fi"
[delta]
	navigate = true
[diff]
	tool = nvimdiff
[difftool "nvimdiff"]
	cmd = nvim -d \"$LOCAL\" \"$REMOTE\"
[difftool]
	prompt = false
[init]
	defaultBranch = main
[url "git@github.com:"]
	insteadOf = https://github.com/
[includeIf "gitdir:~/atelier/github/"]
	path = ~/.gitconfig-personal
[includeIf "gitdir:~/atelier/gitlab/"]
	path = ~/.gitconfig-gitlab
